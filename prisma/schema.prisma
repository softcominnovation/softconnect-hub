generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  apiKeyHash          String   @unique
  adapterType         String   @default("evolution")
  origins             String[]
  hubRelay            Boolean  @default(false)
  batchWebhookEnabled Boolean  @default(false)
  batchWebhookUrl     String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  allocationMode            String    @default("legacy")
  allocationRevision        Int       @default(0)
  capacityFirstAllocationAt DateTime?

  vpsProviderId    String?
  vpsProvider      VpsProvider?           @relation(fields: [vpsProviderId], references: [id])
  instances        Instance[]
  webhookConfigs   WebhookConfig[]
  auditLogs        AuditLog[]
  batchJobs        BatchJob[]
  defaultWebhook   ProductDefaultWebhook?
  defaultProxy     ProductDefaultProxy?
  evolutions       ProductEvolution[]     @relation("ProductEvolutions")
  defaultEvolution ProductEvolution?      @relation("DefaultEvolution", fields: [id, vpsProviderId], references: [productId, vpsProviderId], onDelete: NoAction, onUpdate: NoAction)
  provisionings    InstanceProvisioning[]
  evolutionChanges EvolutionChange[]
}

model EvolutionSetupConfirmation {
  requirementsVersion String   @id
  databaseIdentity    String
  revision            Int      @default(1)
  actor               String
  confirmedAt         DateTime @default(now())
}

// Machine JWTs have no AdminUser foreign key. Keep their administrative audit
// without fabricating a user or changing the existing Manager activity contract.
model EvolutionAdminEvent {
  id        String   @id @default(uuid())
  actor     String
  action    String
  detail    Json
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model EvolutionChange {
  id                String   @id @default(uuid())
  productId         String
  requestId         String
  requestHash       String
  action            String
  actor             String
  draft             Json
  snapshot          Json
  diagnostics       Json?
  result            Json?
  callback          Json?
  status            String   @default("queued")
  stage             String   @default("queued")
  revision          Int      @default(0)
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  executionDeadline DateTime
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, requestId])
  @@index([status, leaseExpiresAt, createdAt])
  @@index([productId, createdAt])
}

model ProductDefaultWebhook {
  id        String   @id @default(uuid())
  productId String   @unique
  enabled   Boolean  @default(true)
  url       String
  headers   Json?
  byEvents  Boolean  @default(false)
  base64    Boolean  @default(false)
  events    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
}

model ProductDefaultProxy {
  id        String   @id @default(uuid())
  productId String   @unique
  enabled   Boolean  @default(true)
  host      String
  port      String
  protocol  String
  username  String?
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
}

model VpsServer {
  id            String   @id @default(uuid())
  label         String
  subdomain     String   @unique
  ip            String
  managerType   String?
  managerUrl    String?
  managerApiKey String?
  monitorUrl    String?
  monitorApiKey String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  providers VpsProvider[]
}

model VpsProvider {
  id             String    @id @default(uuid())
  vpsId          String
  label          String
  providerUrl    String
  providerApiKey String
  adapterType    String    @default("evolution")
  isHealthy      Boolean   @default(true)
  lastHealthAt   DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  maxInstances           Int?
  acceptingNewInstances  Boolean   @default(true)
  configurationRevision  Int       @default(0)
  canonicalEndpoint      String?
  identityStatus         String    @default("pending")
  inventoryStatus        String    @default("unknown")
  inventoryObservedAt    DateTime?
  inventoryRevision      Int       @default(0)
  occupancyRevision      Int       @default(0)
  callbackTokenEncrypted String?
  callbackReadiness      String    @default("pending")

  vps                VpsServer                 @relation(fields: [vpsId], references: [id])
  products           Product[]
  instances          Instance[]
  healthChecks       HealthCheck[]
  productEvolutions  ProductEvolution[]
  reconciliations    EvolutionReconciliation[]
  inventoryEntries   EvolutionInventoryEntry[]
  pendingRelayEvents PendingRelayEvent[]
  provisionings      InstanceProvisioning[]

  @@index([canonicalEndpoint])
}

model ProductEvolution {
  productId             String
  vpsProviderId         String
  allocationPriority    Int      @default(0)
  acceptingNewInstances Boolean  @default(false)
  configurationRevision Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  product            Product                @relation("ProductEvolutions", fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  vpsProvider        VpsProvider            @relation(fields: [vpsProviderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  defaultForProducts Product[]              @relation("DefaultEvolution")
  instances          Instance[]
  provisionings      InstanceProvisioning[]

  @@id([productId, vpsProviderId])
  @@index([vpsProviderId])
  @@index([productId, allocationPriority])
}

model Instance {
  id                 String   @id @default(uuid())
  productId          String
  vpsProviderId      String
  instanceName       String
  providerInstanceId String?
  instanceToken      String?
  hubToken           String   @unique
  phoneNumber        String?
  status             String   @default("disconnected")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product            Product                @relation(fields: [productId], references: [id])
  vpsProvider        VpsProvider            @relation(fields: [vpsProviderId], references: [id])
  auditLogs          AuditLog[]
  batchJobs          BatchJob[]
  evolutionLink      ProductEvolution       @relation(fields: [productId, vpsProviderId], references: [productId, vpsProviderId], onDelete: Restrict, onUpdate: Restrict)
  provisionings      InstanceProvisioning[]
  pendingRelayEvents PendingRelayEvent[]

  @@unique([vpsProviderId, instanceName])
  @@unique([productId, instanceName])
}

model InstanceProvisioning {
  id                 String    @id @default(uuid())
  productId          String
  vpsProviderId      String
  linkProductId      String?
  linkVpsProviderId  String?
  instanceName       String
  requestHash        String
  state              String    @default("reserved")
  instanceId         String?
  providerInstanceId String?
  encryptedRequest   String?
  leaseOwner         String?
  leaseExpiresAt     DateTime?
  revision           Int       @default(0)
  errorCode          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  evolutionLink ProductEvolution? @relation(fields: [linkProductId, linkVpsProviderId], references: [productId, vpsProviderId], onDelete: Restrict, onUpdate: Restrict)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  vpsProvider   VpsProvider       @relation(fields: [vpsProviderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  instance      Instance?         @relation(fields: [instanceId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([state, leaseExpiresAt])
  @@index([instanceId])
}

model EvolutionReconciliation {
  id                        String    @id @default(uuid())
  vpsProviderId             String
  status                    String    @default("pending")
  observedOccupancyRevision Int       @default(0)
  revision                  Int       @default(0)
  leaseOwner                String?
  leaseExpiresAt            DateTime?
  collectionStartedAt       DateTime?
  collectionFinishedAt      DateTime?
  result                    Json?
  errorCode                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  vpsProvider VpsProvider @relation(fields: [vpsProviderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, leaseExpiresAt])
  @@index([vpsProviderId, createdAt])
}

model EvolutionInventoryEntry {
  vpsProviderId      String
  identityKey        String
  instanceName       String
  providerInstanceId String?
  status             String?
  inventoryRevision  Int
  observedAt         DateTime

  vpsProvider VpsProvider @relation(fields: [vpsProviderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([vpsProviderId, identityKey])
  @@index([vpsProviderId, instanceName])
}

model PendingRelayEvent {
  id                 String    @id @default(uuid())
  vpsProviderId      String?
  instanceId         String?
  instanceName       String?
  providerInstanceId String?
  encryptedPayload   String
  originEvidence     Json?
  state              String    @default("pending")
  errorCode          String?
  receivedAt         DateTime  @default(now())
  resolvedAt         DateTime?

  vpsProvider VpsProvider? @relation(fields: [vpsProviderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  instance    Instance?    @relation(fields: [instanceId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([state, receivedAt])
  @@index([vpsProviderId, instanceName])
}

model WebhookConfig {
  id        String   @id @default(uuid())
  productId String
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  productId  String
  instanceId String?
  endpoint   String
  method     String
  statusCode Int
  latencyMs  Int
  origin     String?
  ip         String
  errorMsg   String?
  createdAt  DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id])
  instance Instance? @relation(fields: [instanceId], references: [id])
}

model AdminUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  type         String   @default("admin")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activityLogs AdminActivityLog[]
}

model AdminActivityLog {
  id          String   @id @default(uuid())
  adminUserId String
  action      String
  detail      String?
  ip          String?
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])
}

model HealthCheck {
  id            String   @id @default(uuid())
  vpsProviderId String
  status        String
  responseMs    Int
  errorMsg      String?
  checkedAt     DateTime @default(now())

  vpsProvider VpsProvider @relation(fields: [vpsProviderId], references: [id])
}

model BatchJob {
  id            String    @id @default(uuid())
  productId     String
  instanceId    String?
  totalMessages Int
  sentCount     Int       @default(0)
  failedCount   Int       @default(0)
  status        String    @default("processing")
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  product  Product   @relation(fields: [productId], references: [id])
  instance Instance? @relation(fields: [instanceId], references: [id])
}
