# =============================================================================
# SoftConnect 2.0 — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env no git.
# =============================================================================

# --- Banco de dados ---
# Desenvolvimento LOCAL (Postgres rodando na máquina):
DATABASE_URL="postgresql://postgres:SUA_SENHA@127.0.0.1:5432/whatshub?schema=public"

# Em produção/dev na VPS, DATABASE_URL é montada pelo docker-compose com os vars abaixo:
# POSTGRES_PASSWORD_PROD → senha do serviço postgres_prod (stack Docker Swarm)
# POSTGRES_PASSWORD_DEV  → senha do serviço postgres_dev  (stack Docker Swarm)
# Os hostnames são hardcoded nos docker-compose: postgres_prod / postgres_dev

# --- Redis ---
# Desenvolvimento LOCAL (Redis rodando na máquina):
REDIS_URL="redis://127.0.0.1:6379/0"
# Em produção/dev na VPS, REDIS_URL é hardcoded nos docker-compose: redis_prod / redis_dev

# --- Segurança ---
# ENCRYPTION_KEY: exatamente 64 caracteres hexadecimais (= 32 bytes para AES-256-GCM)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="GERE_UMA_CHAVE_HEX_DE_64_CHARS_AQUI"

# JWT_SECRET: string aleatória longa para assinar tokens JWT do Admin Plane
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="GERE_UM_SECRET_JWT_AQUI"

# ADMIN_SECRET: senha usada no endpoint POST /admin/auth/login para obter o JWT
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET="GERE_UM_ADMIN_SECRET_AQUI"

# Tempo de expiração do JWT admin em segundos (86400 = 24h)
ADMIN_JWT_EXPIRY=86400

# --- Performance ---
DEFAULT_RATE_LIMIT=100
PROXY_TIMEOUT_MS=15000
PROXY_MAX_RETRIES=1

# --- Prazos dos endpoints síncronos de mídia (MID-01) ---
# Request >= download + provider + 30000 ms; não altera os prazos de texto/QR.
MEDIA_REQUEST_TIMEOUT_MS=900000
MEDIA_PROVIDER_TIMEOUT_MS=600000
# Prazo de preparação do núcleo de mídia (ativação nos fluxos na MID-03).
MEDIA_DOWNLOAD_TIMEOUT_MS=240000

# --- Núcleo de tamanho/preparação (MID-02; integração nas rotas/batch na MID-03) ---
# MB decimais; 50 = 50.000.000 bytes por arquivo.
MEDIA_MAX_SIZE_MB=50
MEDIA_MAX_CONCURRENT=2
# Opcional: caminho absoluto de temporários. Ausente usa o temporário do runtime.
# MEDIA_TMP_DIR=/tmp/softconnect-media
# Exceções para fontes privadas: origens exatas (esquema+host+porta), sem caminhos.
# Nunca libera loopback, link-local, metadata ou redes reservadas.
MEDIA_SOURCE_ALLOWED_HOSTS=

CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_MS=30000

# --- Audit log (write-behind buffer) ---
AUDIT_FLUSH_INTERVAL_MS=1000
AUDIT_FLUSH_BATCH_SIZE=100

# --- Adapter padrão ---
DEFAULT_ADAPTER_TYPE=evolution

# --- Debug ---
# CACHE_DEBUG: quando true, loga HIT/MISS do cache de instância no hot path com tempo de resposta
# Útil para diagnosticar latência no envio de mensagens. Manter false em produção.
CACHE_DEBUG=false

# --- System Monitor (opcional) ---
# URL base do agente system-monitor instalado no próprio servidor do hub.
# Quando configurado, o endpoint GET /admin/health/hub/metrics retorna métricas em tempo real.
# Gere a chave com: openssl rand -hex 32
# HUB_MONITOR_URL=http://localhost:8001
# HUB_MONITOR_API_KEY=<sua-chave-aqui>

# --- Seed de desenvolvimento (prisma/seed.ts) ---
SEED_VPS_LABEL="VPS Desenvolvimento"
SEED_VPS_SUBDOMAIN="vps-dev.local"
SEED_VPS_URL="http://vps-dev.local"
SEED_VPS_IP="127.0.0.1"
SEED_VPS_API_KEY="SUA_API_KEY_DA_VPS_EVOLUTION"
SEED_PRODUCT_NAME="Meu Produto Dev"
SEED_PRODUCT_SLUG="meu-produto-dev"
SEED_PRODUCT_API_KEY="sk_dev_GERE_UMA_CHAVE_AQUI"
SEED_WEBHOOK_URL="http://localhost:5678/webhook/dev"
SEED_WEBHOOK_SECRET="GERE_UM_SECRET_DE_WEBHOOK_AQUI"
